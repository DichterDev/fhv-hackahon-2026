[Unit]
Description=Hackathon React AI Frontend
After=network-online.target

[Container]
Image=localhost/hack-frontend:latest
ContainerName=hack-frontend
Network=proxy.network
Network=hackathon.network

EnvironmentFile=%h/dichter.dev/hackathon.dichter.dev/.env

Label=traefik.enable=true
Label=traefik.docker.network=proxy.network
Label=traefik.http.routers.hack-frontend.rule=Host(`hackathon.dichter.dev`)
Label=traefik.http.routers.hack-frontend.entrypoints=websecure
Label=traefik.http.routers.hack-frontend.tls.certresolver=cloudflare
Label=traefik.http.routers.hack-frontend.priority=1
Label=traefik.http.services.hack-frontend.loadbalancer.server.port=80

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
